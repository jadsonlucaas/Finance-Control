# Porta HTTP interna (a rede Docker do n8n deve alcancar este container).
PORT=3000

# Chave compartilhada com o n8n (header x-api-key ou Authorization: Bearer).
# Gere com: openssl rand -hex 32
WHATSAPP_API_KEY=

# Vinculo telefone -> usuario (fase de teste, ate existir o cadastro do WhatsApp).
# chatwootAccountId e opcional; quando informado, o accountId da chamada precisa bater.
WHATSAPP_PHONE_LINKS=[{"telefone":"+00000000000","uid":"FIREBASE_UID_AQUI","chatwootAccountId":"3"}]

# Credencial da service account do Firebase (JSON em uma linha) OU
# GOOGLE_APPLICATION_CREDENTIALS apontando para o arquivo montado no container.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Apenas desenvolvimento local: "memory" usa um banco em memoria e ignora o Firebase.
# WHATSAPP_API_STORE=memory
WHATSAPP_ACCESS_MODE=open
